generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid()) @db.UniqueIdentifier
  email             String              @unique @db.VarChar(320)
  username          String              @unique @db.VarChar(100)
  passwordHash      String              @db.VarChar(255)
  passwordMustChange Boolean             @default(false)
  passwordChangedAt DateTime?
  firstName         String?             @db.VarChar(100)
  lastName          String?             @db.VarChar(100)
  status            String              @default("ACTIVE") @db.VarChar(30)
  sessionVersion    Int                 @default(0)
  lastLoginAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  roles             UserRole[]
  devices           Device[]
  explicitAppAccess AppUserPermission[]
  installationLogs  InstallationLog[]
  createdApps       App[]               @relation("CreatedApps")
  createdVersions   AppVersion[]        @relation("CreatedVersions")
  refreshTokens     RefreshToken[]

  @@index([status])
}

model Role {
  id             String              @id @default(uuid()) @db.UniqueIdentifier
  code           String              @unique @db.VarChar(50)
  name           String              @db.VarChar(100)
  description    String?             @db.VarChar(500)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  users          UserRole[]
  appPermissions AppRolePermission[]
}

model UserRole {
  userId     String   @db.UniqueIdentifier
  roleId     String   @db.UniqueIdentifier
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, roleId])
}

model Device {
  id               String            @id @default(uuid()) @db.UniqueIdentifier
  userId           String?           @db.UniqueIdentifier
  deviceIdentifier String            @unique @db.VarChar(191)
  name             String            @db.VarChar(150)
  platform         String            @default("ANDROID") @db.VarChar(30)
  manufacturer     String?           @db.VarChar(120)
  model            String?           @db.VarChar(120)
  osVersion        String?           @db.VarChar(50)
  appVersionName   String?           @db.VarChar(60)
  pushToken        String?           @db.VarChar(255)
  status           String            @default("ACTIVE") @db.VarChar(30)
  lastSeenAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User?             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appStates        DeviceAppState[]
  installationLogs InstallationLog[]

  @@index([userId])
  @@index([status])
}

model App {
  id                     String              @id @default(uuid()) @db.UniqueIdentifier
  packageName            String              @unique @db.VarChar(255)
  slug                   String              @unique @db.VarChar(150)
  displayName            String              @db.VarChar(150)
  shortDescription       String?             @db.VarChar(300)
  description            String?             @db.Text
  iconPath               String?             @db.VarChar(500)
  bannerPath             String?             @db.VarChar(500)
  category               String?             @db.VarChar(100)
  status                 String              @default("DRAFT") @db.VarChar(30)
  requiresExplicitAccess Boolean             @default(false)
  createdById            String?             @db.UniqueIdentifier
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  createdBy              User?               @relation("CreatedApps", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions               AppVersion[]
  userPermissions        AppUserPermission[]
  rolePermissions        AppRolePermission[]
  deviceStates           DeviceAppState[]
  installationLogs       InstallationLog[]

  @@index([status])
}

model AppVersion {
  id                      String             @id @default(uuid()) @db.UniqueIdentifier
  appId                   String             @db.UniqueIdentifier
  versionName             String             @db.VarChar(60)
  versionCode             Int
  changelog               String?            @db.Text
  apkPath                 String             @db.VarChar(500)
  originalFileName        String?            @db.VarChar(255)
  contentType             String?            @db.VarChar(120)
  fileExtension           String?            @db.VarChar(20)
  archiveEntryCount       Int?
  fileSizeBytes           BigInt?
  sha256                  String?            @db.VarChar(128)
  minSupportedVersionCode Int?
  isMandatory             Boolean            @default(false)
  createdById             String?            @db.UniqueIdentifier
  releasedAt              DateTime           @default(now())
  app                     App                @relation(fields: [appId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy               User?              @relation("CreatedVersions", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deviceStates            DeviceAppState[]
  installationLogs        InstallationLog[]

  @@unique([appId, versionCode])
  @@index([appId, releasedAt])
}

model DeviceAppState {
  id                   String      @id @default(uuid()) @db.UniqueIdentifier
  deviceId             String      @db.UniqueIdentifier
  appId                String      @db.UniqueIdentifier
  installedVersionId   String?     @db.UniqueIdentifier
  installedVersionCode Int?
  installedVersionName String?     @db.VarChar(60)
  status               String      @default("UNKNOWN") @db.VarChar(30)
  lastReportedAt       DateTime    @default(now())
  lastOpenedAt         DateTime?
  notes                String?     @db.VarChar(500)
  device               Device      @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app                  App         @relation(fields: [appId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  installedVersion     AppVersion? @relation(fields: [installedVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([deviceId, appId])
  @@index([appId])
}

model AppUserPermission {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  appId      String   @db.UniqueIdentifier
  userId     String   @db.UniqueIdentifier
  canView    Boolean  @default(true)
  canInstall Boolean  @default(true)
  createdAt  DateTime @default(now())
  app        App      @relation(fields: [appId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([appId, userId])
}

model AppRolePermission {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  appId      String   @db.UniqueIdentifier
  roleId     String   @db.UniqueIdentifier
  canView    Boolean  @default(true)
  canInstall Boolean  @default(true)
  createdAt  DateTime @default(now())
  app        App      @relation(fields: [appId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([appId, roleId])
}

model InstallationLog {
  id                   String      @id @default(uuid()) @db.UniqueIdentifier
  appId                String      @db.UniqueIdentifier
  appVersionId         String?     @db.UniqueIdentifier
  deviceId             String?     @db.UniqueIdentifier
  userId               String?     @db.UniqueIdentifier
  action               String      @db.VarChar(30)
  status               String      @default("PENDING") @db.VarChar(30)
  installedVersionCode Int?
  requestedVersionCode Int?
  details              String?     @db.VarChar(1000)
  createdAt            DateTime    @default(now())
  app                  App         @relation(fields: [appId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appVersion           AppVersion? @relation(fields: [appVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  device               Device?     @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                 User?       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([appId, createdAt])
  @@index([deviceId, createdAt])
}

model RefreshToken {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  userId         String   @db.UniqueIdentifier
  tokenHash      String   @unique @db.VarChar(128)
  sessionVersion Int
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}
