{
  "name": "corporate-app-store-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for a private corporate Android app store.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/auth-permissions-download.test.ts",
    "start": "node dist/server.js",
    "apk:auto-import:once": "tsx src/cli/apk-auto-import-once.ts",
    "users:create-requested": "tsx scripts/create-requested-users.ts",
    "prisma:create-db": "tsx scripts/create-sqlserver-db.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:smoke": "tsx scripts/prisma-smoke.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "prisma": "^6.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
